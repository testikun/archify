{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Minimal Lifecycle",
    "output": "minimal.html",
    "quality_profile": "showcase"
  },
  "mainPath": [
    "queued",
    "done"
  ],
  "states": [
    {
      "id": "queued",
