{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Retry policy",
    "subtitle": "A branch explains when the next action is taken",
    "output": "retry.html",
    "quality_profile": "showcase",
    "visual_preset": "classic"
  },
  "lanes": [
    {
      "id": "attempt",
      "label": "Request handling"
    },
    {
      "id": "fallback",
      "label": "Fallback",
      "variant": "exception"
    }
  ],
  "nodes": [
    {
      "id": "budget",
      "lane": "attempt",
      "col": 0,
      "type": "backend",
      "decision": true,
      "label": "Retry policy",
      "sublabel": "remaining attempts",
      "width": 170
    },
    {
      "id": "again",
      "lane": "attempt",
      "col": 3,
      "type": "backend",
      "label": "Try again",
      "width": 150
    },
    {
      "id": "fallback",
      "lane": "fallback",
      "col": 3,
      "type": "external",
      "label": "Ask operator",
      "width": 150
    }
  ],
  "edges": [
    {
      "id": "remaining",
      "from": "budget",
      "to": "again",
      "condition": {
        "value": "Budget remaining"
      },
      "label": "retry request"
    },
    {
      "id": "exhausted",
      "from": "budget",
      "to": "fallback",
      "condition": {
        "value": "Budget exhausted"
      },
      "label": "escalate",
      "role": "error",
      "variant": "security"
    }
  ]
}
